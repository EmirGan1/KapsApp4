# AI Studio & Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Turso / LibSQL)
# Defaults to local embedded database "file:local.db" when not provided
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Subject Resources Data Directory (optional)
SUBJECT_RESOURCES_DIR=

# Feature & Debug Flags (optional)
ENABLE_GAME_TEST_ENDPOINTS=
STRIKE_COMBAT_DEBUG=

# AI Integration (optional)
GEMINI_API_KEY=