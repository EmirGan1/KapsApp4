# AI Studio & Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Precedence:
#   1. TURSO_DATABASE_URL / LIBSQL_URL (remote libsql:// or explicit file:/abs/path.db)
#   2. DATABASE_PATH / KAPSAPP_DB_PATH / SQLITE_DB_PATH (explicit SQLite file path)
#   3. KAPSAPP_DATA_DIR / DATA_DIR (resolves to <dir>/kapsapp.db)
#   4. Production default (NODE_ENV=production): /var/lib/kapsapp/kapsapp.db
#   5. Development default: ./local.db (gitignored)
#
# Production MUST store SQLite outside the Git working directory (e.g. /var/lib/kapsapp).
KAPSAPP_DATA_DIR=/var/lib/kapsapp
DATABASE_PATH=/var/lib/kapsapp/kapsapp.db
# Optional alias for DATABASE_PATH:
# KAPSAPP_DB_PATH=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Subject Resources Data Directory (optional)
SUBJECT_RESOURCES_DIR=

# Feature & Debug Flags (optional)
ENABLE_GAME_TEST_ENDPOINTS=
STRIKE_COMBAT_DEBUG=

# AI Integration (optional)
GEMINI_API_KEY=

# KapsApp AI (local Ollama) & Desklib Detector
KAPSAPP_AI_ENABLED=1
KAPSAPP_AI_METRICS=0
KAPSAPP_AI_THREADS=
KAPSAPP_AI_KEEP_ALIVE=45s
KAPSAPP_AI_COLD_MEM_MIB=2560
KAPSAPP_AI_MAX_QUEUE=2
KAPSAPP_AI_CONNECT_TIMEOUT_MS=10000
KAPSAPP_AI_QUEUE_TIMEOUT_MS=90000
KAPSAPP_AI_MODEL_LOAD_TIMEOUT_MS=120000
KAPSAPP_AI_FIRST_TOKEN_TIMEOUT_MS=180000
KAPSAPP_AI_TOKEN_IDLE_TIMEOUT_MS=60000
# Time to first output and time spent generating are budgeted separately.
KAPSAPP_AI_TOTAL_TIMEOUT_MS=420000
KAPSAPP_AI_GENERATION_TIMEOUT_MS=900000
DESKLIB_PORT=8765

# Private Dido / Emirgan travel planner. Set verified existing production IDs.
KAPSAPP_TRAVEL_DIDO_ID=
KAPSAPP_TRAVEL_EMIRGAN_ID=

# Verified existing Emirgan ID for the private university archive.
KAPSAPP_UNIVERSITY_EMIRGAN_ID=

# Kaps German private Google Docs connection. Keep real values out of git.
KAPS_GERMAN_GOOGLE_CLIENT_ID=
KAPS_GERMAN_GOOGLE_CLIENT_SECRET=
KAPS_GERMAN_GOOGLE_REDIRECT_URI=https://kapsapp.online/api/kaps-german-google/callback
# Optional override if personal Google Docs uses a separate redirect URI
KAPS_GERMAN_PERSONAL_GOOGLE_REDIRECT_URI=
KAPS_GERMAN_TOKEN_KEY=
GROQ_API_KEY=
GROQ_API_KEY_FILE=/etc/kapsapp/groq-api-key
KAPS_GERMAN_GROQ_MODEL=openai/gpt-oss-120b
# Local fallback is opt-in and needs verified model availability + free RAM.
KAPS_GERMAN_OLLAMA_MODEL=
