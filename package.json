{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/generate-seo-pages.js",
    "start": "node --max-old-space-size=1536 dist/server.cjs",
    "pm2": "pm2 restart ecosystem.config.cjs --env production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "node --import tsx --test tests/passwordReset.test.ts",
    "test:battle": "node --import tsx --test tests/battleRoyale.test.ts",
    "test:kapstorial": "node --import tsx --test tests/kapstorial.test.ts",
    "test:kapstorial:browser": "node --import tsx tests/kapstorial.browser.ts",
    "test:dungeon": "node --import tsx --test tests/dungeon.test.ts tests/dungeon.network.test.ts tests/dungeon.expeditions.test.ts",
    "test:dungeon:browser": "node --import tsx tests/dungeon.browser.ts",
    "test:dungeon:expedition": "node --import tsx tests/dungeon.full-browser.ts",
    "test:dungeon:performance": "node --import tsx tests/dungeon.performance.ts",
    "test:strike": "node --import tsx --test tests/kapsstrike.test.ts tests/kapsstrike.scene.test.ts tests/kapsstrike.multiplayer.test.ts tests/kapsstrike.controls.test.ts tests/kapsstrike.skins.test.ts tests/kapsstrike.routes.test.ts tests/kapsstrike.transport.test.ts tests/kapsstrike.invite.test.ts",
    "test:strike:browser": "node --import tsx tests/kapsstrike.browser.ts",
    "test:strike:menu": "node --import tsx tests/kapsstrike.menu.browser.ts",
    "test:strike:maps": "node --import tsx tests/kapsstrike.maps.browser.ts",
    "test:strike:controller": "node --import tsx tests/kapsstrike.browser.ts --null",
    "test:strike:network": "node --import tsx tests/kapsstrike.network.browser.ts"
  },
  "dependencies": {
    "@babylonjs/core": "8.50.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/leaflet": "^1.9.22",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.14.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sqlite3": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "1.51.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
